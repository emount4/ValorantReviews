# Игнорировать файл config.txt
config.txt

# Игнорировать все лог файлы в корне
*.log

# Не игнорировать этот файл
!important.log

# Игнорировать все файлы в папке temp, кроме *.keep
/temp/*
!/temp/*.keep

# Игнорировать все файлы с расширением .pyc
*.pyc

# Игнорировать все файлы в папке logs и подпапках
/logs/**

# Игнорировать файлы в корне, начинающиеся с temp_
/temp_*

*.env